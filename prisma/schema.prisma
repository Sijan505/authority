generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  MEMBER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum PackageType {
  BASIC
  PRO
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SubscriptionStatus {
  PENDING_PAYMENT
  ACTIVE
  REJECTED
  CANCELLED
}

enum PaymentMethod {
  ESEWA
  KHALTI
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
}

enum ShareholderRole {
  OWNER
  TECHNICAL_PARTNER
}

enum PeriodStatus {
  OPEN
  FINALIZED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum RequestStatus {
  NEW
  IN_PROGRESS
  DONE
  DECLINED
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

model User {
  id             String     @id @default(cuid())
  email          String     @unique // one account per Google email
  googleId       String?    @unique @map("google_id")
  name           String?
  image          String?
  photo          Bytes? // uploaded profile photo (JPEG, ~512px square); left out of queries by default (lib/db.ts)
  photoUpdatedAt DateTime?  @map("photo_updated_at")
  memberCode     String?    @unique @map("member_code") // secret code in the membership card QR (/verify/[code])
  role           Role       @default(MEMBER)
  status         UserStatus @default(ACTIVE)
  fieldId        String?    @map("field_id")
  city           String?
  contact        String?
  onboardedAt    DateTime?  @map("onboarded_at")
  groupReadAt    DateTime?  @map("group_read_at") // last time they opened the members' group chat
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  field               Field?             @relation(fields: [fieldId], references: [id])
  application         Application?
  subscriptions       Subscription[]
  payments            Payment[]          @relation("PaymentUser")
  verifiedPayments    Payment[]          @relation("PaymentVerifier")
  comments            Comment[]
  posts               DiscussionPost[]
  reports             Report[]           @relation("Reporter")
  resolvedReports     Report[]           @relation("Resolver")
  blocking            UserBlock[]        @relation("Blocker")
  blockedBy           UserBlock[]        @relation("Blocked")
  auditLogs           AuditLog[]
  requests            ConciergeRequest[]
  sentConnections     Connection[]       @relation("ConnectionRequester")
  receivedConnections Connection[]       @relation("ConnectionAddressee")
  sentMessages        Message[]          @relation("MessageSender")
  receivedMessages    Message[]          @relation("MessageRecipient")
  notifications       Notification[]     @relation("NotificationUser")
  causedNotifications Notification[]     @relation("NotificationActor")
  pushSubscriptions   PushSubscription[]
  groupMessages       GroupMessage[]

  @@index([fieldId])
  @@map("users")
}

model Field {
  id       String @id @default(cuid())
  slug     String @unique
  name     String
  position Int    @default(0)

  users        User[]
  applications Application[]
  articles     Article[]
  posts        DiscussionPost[]
  offers       Offer[]

  @@map("fields")
}

model Application {
  id           String   @id @default(cuid())
  userId       String   @unique @map("user_id")
  fieldId      String   @map("field_id")
  name         String
  city         String
  contact      String
  perks        String[]
  deposit      String? // Yes / Maybe / No; no longer asked (Nov 2026), kept for earlier answers
  helpBuild    String   @map("help_build")
  contribution String?
  status       String   @default("SUBMITTED")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  field Field @relation(fields: [fieldId], references: [id])

  @@map("applications")
}

model Subscription {
  id           String             @id @default(cuid())
  userId       String             @map("user_id")
  package      PackageType
  billingCycle BillingCycle       @map("billing_cycle")
  status       SubscriptionStatus @default(PENDING_PAYMENT)
  startsAt     DateTime?          @map("starts_at")
  expiresAt    DateTime?          @map("expires_at")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([userId, status])
  @@map("subscriptions")
}

model Payment {
  id             String        @id @default(cuid())
  subscriptionId String        @map("subscription_id")
  userId         String        @map("user_id")
  amount         Int // NPR
  method         PaymentMethod
  reference      String
  screenshot     Bytes?
  screenshotType String?       @map("screenshot_type")
  status         PaymentStatus @default(PENDING)
  note           String?
  verifiedById   String?       @map("verified_by")
  verifiedAt     DateTime?     @map("verified_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  user         User         @relation("PaymentUser", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy   User?        @relation("PaymentVerifier", fields: [verifiedById], references: [id])

  @@index([status])
  @@map("payments")
}

model Article {
  id          String        @id @default(cuid())
  title       String
  slug        String        @unique
  excerpt     String
  body        String
  fieldId     String        @map("field_id")
  authorName  String        @map("author_name")
  tags        String[]
  status      ArticleStatus @default(DRAFT)
  publishedAt DateTime?     @map("published_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  field    Field     @relation(fields: [fieldId], references: [id])
  comments Comment[]

  @@index([fieldId, status, publishedAt])
  @@map("articles")
}

model Comment {
  id        String    @id @default(cuid())
  articleId String    @map("article_id")
  userId    String    @map("user_id")
  body      String
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  article Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reports Report[]

  @@index([articleId, createdAt])
  @@map("comments")
}

model DiscussionPost {
  id        String    @id @default(cuid())
  fieldId   String    @map("field_id")
  userId    String    @map("user_id")
  parentId  String?   @map("parent_id") // set for replies
  body      String
  removedAt DateTime? @map("removed_at")
  createdAt DateTime  @default(now()) @map("created_at")

  field   Field            @relation(fields: [fieldId], references: [id])
  user    User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  DiscussionPost?  @relation("Replies", fields: [parentId], references: [id], onDelete: Cascade)
  replies DiscussionPost[] @relation("Replies")
  reports Report[]

  @@index([fieldId, parentId, createdAt])
  @@map("discussion_posts")
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String       @map("reporter_id")
  commentId    String?      @map("comment_id")
  postId       String?      @map("post_id")
  reason       String
  status       ReportStatus @default(OPEN)
  resolvedById String?      @map("resolved_by")
  resolvedAt   DateTime?    @map("resolved_at")
  createdAt    DateTime     @default(now()) @map("created_at")

  reporter   User            @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  resolvedBy User?           @relation("Resolver", fields: [resolvedById], references: [id])
  comment    Comment?        @relation(fields: [commentId], references: [id], onDelete: Cascade)
  post       DiscussionPost? @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([status])
  @@map("reports")
}

// A member hiding another member's Pro content from themselves.
model UserBlock {
  blockerId String   @map("blocker_id")
  blockedId String   @map("blocked_id")
  createdAt DateTime @default(now()) @map("created_at")

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@map("user_blocks")
}

model Offer {
  id           String    @id @default(cuid())
  fieldId      String    @map("field_id")
  name         String
  venue        String
  discountText String    @map("discount_text")
  validFrom    DateTime? @map("valid_from")
  validUntil   DateTime? @map("valid_until")
  active       Boolean   @default(true)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  field Field @relation(fields: [fieldId], references: [id])

  @@index([fieldId, active])
  @@map("offers")
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@map("audit_logs")
}

// The Request Desk: a member asks, a person on the team replies (app/app/concierge).
model ConciergeRequest {
  id            String        @id @default(cuid())
  userId        String        @map("user_id")
  category      String // config/site.ts conciergeCategories
  details       String
  city          String?
  date          String? // as the member wrote it, e.g. "Sat 6 Dec" or "this weekend"
  people        Int?
  status        RequestStatus @default(NEW)
  reply         String? // first-version single reply; now copied into messages and no longer written
  needsTeam     Boolean       @default(true) @map("needs_team") // the member wrote last; waiting for the team
  memberUnread  Boolean       @default(false) @map("member_unread") // the team wrote; the member hasn't opened it
  repliesLocked Boolean       @default(false) @map("replies_locked") // the team closed it to further member replies
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  user     User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ConciergeMessage[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@map("concierge_requests")
}

// The conversation on a Request Desk request: the member and the team, in turn.
model ConciergeMessage {
  id        String    @id @default(cuid())
  requestId String    @map("request_id")
  fromTeam  Boolean   @map("from_team")
  authorId  String?   @map("author_id") // the member, or the admin who replied
  body      String
  editedAt  DateTime? @map("edited_at") // set when an admin edits the message
  createdAt DateTime  @default(now()) @map("created_at")

  request ConciergeRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt])
  @@map("concierge_messages")
}

// Members connecting with each other: one row per pair, created by the requester.
model Connection {
  id          String           @id @default(cuid())
  requesterId String           @map("requester_id")
  addresseeId String           @map("addressee_id")
  status      ConnectionStatus @default(PENDING)
  createdAt   DateTime         @default(now()) @map("created_at")
  respondedAt DateTime?        @map("responded_at")

  requester User @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("ConnectionAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@map("connections")
}

// Private messages between two connected members.
model Message {
  id          String    @id @default(cuid())
  senderId    String    @map("sender_id")
  recipientId String    @map("recipient_id")
  body        String
  editedAt    DateTime? @map("edited_at") // set when the sender edits it
  readAt      DateTime? @map("read_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  sender    User @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
  @@map("messages")
}

// The members' group chat: every active member is in it (app/app/messages/group).
// kind "join" is the notice posted when someone first becomes a member; joinKey
// (their user id) keeps it to one per person.
model GroupMessage {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  kind      String    @default("message") // message | join
  body      String
  joinKey   String?   @unique @map("join_key")
  editedAt  DateTime? @map("edited_at") // set when the author edits it
  removedAt DateTime? @map("removed_at") // removed by an admin; an author's unsend deletes the row
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("group_messages")
}

// In-app notifications; each new one is also pushed to the member's phones.
model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  actorId   String?   @map("actor_id")
  type      String // connect.request | connect.accepted | message | concierge.reply
  text      String
  link      String
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user  User  @relation("NotificationUser", fields: [userId], references: [id], onDelete: Cascade)
  actor User? @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

// A phone or browser that agreed to receive push notifications.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// ---- Shareholder revenue share (admin only; lib/revenue.ts) ----

// An owner or the technical partner, with a fixed ownership share.
model Shareholder {
  id          String          @id @default(cuid())
  name        String
  role        ShareholderRole
  basisPoints Int             @map("basis_points") // ownership in hundredths of a percent: 35.50% = 3550
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  allocations RevenueAllocation[]

  @@map("shareholders")
}

// A calendar month (Nepal time) once an admin has finalised it. Open months are
// calculated live and have no row, or a row with status OPEN after a reopen.
model RevenuePeriod {
  id            String       @id @default(cuid())
  month         String       @unique // "YYYY-MM"
  status        PeriodStatus @default(OPEN)
  netSalesPaisa BigInt       @map("net_sales_paisa") // verified payments in the month, in paisa
  paymentCount  Int          @map("payment_count")
  finalizedAt   DateTime?    @map("finalized_at")
  finalizedById String?      @map("finalized_by")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  allocations RevenueAllocation[]

  @@map("revenue_periods")
}

// One shareholder's amount for a finalised month. Name, role and share are copied
// at finalising, so later changes (or deleting the shareholder) never alter it.
model RevenueAllocation {
  id            String          @id @default(cuid())
  periodId      String          @map("period_id")
  shareholderId String?         @map("shareholder_id")
  name          String
  role          ShareholderRole
  basisPoints   Int             @map("basis_points")
  amountPaisa   BigInt          @map("amount_paisa")

  period      RevenuePeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)
  shareholder Shareholder?  @relation(fields: [shareholderId], references: [id], onDelete: SetNull)

  @@unique([periodId, shareholderId])
  @@map("revenue_allocations")
}

// Fixed-window counters for rate limiting, shared across server instances.
model RateLimit {
  key         String   @id
  count       Int
  windowStart DateTime @map("window_start")

  @@map("rate_limits")
}

// Answers from the public interest form (components/Inquiry.tsx). Rows from the first
// version of the form (Nov 2026) have email/world/role/building/bring set instead of
// the newer columns, which is why most columns are optional here.
model Inquiry {
  id           String   @id @default(cuid())
  name         String
  city         String
  field        String?
  contact      String?  @unique // normalised email or +977… WhatsApp; one sign-up each
  contactType  String?  @map("contact_type") // "email" | "whatsapp"
  perks        String[] @default([]) // no longer asked
  priceBand    String?  @map("price_band") // no longer asked
  craft        String? // where we can see their work: Instagram, TikTok, X handles or links
  about        String? // about them, and the change they hope to bring
  deposit      String? // Yes / Maybe / No (no longer asked)
  helpBuild    String?  @map("help_build")
  contribution String[] @default([])
  source       String? // Instagram, TikTok, Referral… (config/site.ts inquirySources)
  sourceDetail String?  @map("source_detail") // raw utm_source / ref / referring host
  // First version of the form
  email        String?
  whatsapp     String?
  world        String?
  role         String?
  building     String?
  link         String?
  interests    String[] @default([])
  bring        String?
  referrer     String?
  notes        String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@map("inquiries")
}
