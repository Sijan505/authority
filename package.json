{
  "name": "authority",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "prisma generate",
    "db:seed": "prisma db seed",
    "db:sync-fields": "tsx prisma/seed-fields.ts",
